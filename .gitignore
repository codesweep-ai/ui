# Deliberately not ignored, and committed on purpose: CATALOG.md and
# catalog.json, which are generated from the component frontmatter and reviewed
# in the diff, and visual-baseline/, which is the set of screenshots
# `npm run visual:compare` measures a change against.

# Dependencies. Not anchored, because a nested package directory is as unwanted
# as the one at the root.
node_modules/

# The library build, and the preview built as static files. Anchored, so a
# source directory named dist/ somewhere in the tree is not caught by a rule
# meant for build output.
/dist/
/preview/dist/

# TypeScript's incremental build state, which is a fact about one machine.
*.tsbuildinfo

# Coverage, measured on every test run and true of that run only.
/coverage/

# A scratch directory for work in progress, so an experiment never reaches a
# commit by way of `git add -A`.
/tmp/

# A local .env is where a credential lands first, and ignoring it is what keeps
# the next `git add -A` from publishing it.
.env
.env.local

# Editor and OS residue, which reaches a tree through `git add -A`.
.DS_Store

# Agent harness configuration, which is personal to whoever runs it.
/.claude/

# Generated by `npm run marketing:finalize` from a chosen variant, and consumed
# by the production build.
/marketing-preview/content/final.json

# Screenshots and attachments a failing browser test leaves behind.
__screenshots__/
.vitest-attachments/
/visual-diff/
*.tgz
